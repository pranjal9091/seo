# ==============================================================================
# OmniGEO — Production & Development Environment Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env.local)
# Never commit real API keys or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Environment mode: "development" or "production"
ENVIRONMENT=development

# Database connection: SQLite path or PostgreSQL URI
# For local development: sqlite:///./omnigeo.db
# For production with persistent disk: sqlite:////data/omnigeo.db
# For managed database: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./omnigeo.db

# Allowed frontend origins for CORS (comma-separated)
# In development, localhost origins are automatically allowed.
# In production, specify your exact deployed frontend domain(s).
FRONTEND_ORIGIN=http://localhost:5173

# Public Canonical Site URL (used for canonical tags, sitemap.xml, robots.txt)
# In development: http://localhost:5173
# In production: https://omnigeo.vercel.app
SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Optional AI Search Visibility Providers
# ------------------------------------------------------------------------------
# If left blank, OmniGEO operates seamlessly using the Manual Observation Import
# workflow, allowing zero-cost evaluation of ChatGPT, Gemini, and Perplexity answers.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Optional server-side GA4 verification check
GA4_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Base API URL:
# In development: leave empty to use local Vite proxy (/api)
# In production: set to your deployed backend origin (e.g. https://api.omnigeo.io)
VITE_API_BASE_URL=

# Public Canonical Site URL for frontend canonicals and Open Graph tags
VITE_SITE_URL=http://localhost:5173

# Real GA4 Measurement ID (format: G-XXXXXXXXXX)
# Keep empty if no live GA4 stream exists. The platform will honestly report
# "GA4 not configured" without error.
VITE_GA4_MEASUREMENT_ID=
